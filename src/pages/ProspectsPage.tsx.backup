// Add to Sequence modal component
const AddToSequenceModal: React.FC<{
  isOpen: boolean;
  onClose: () => void;
  onAddToSequence: (sequenceId: string) => void;
  loading?: boolean;
}> = ({ isOpen, onClose, onAddToSequence, loading }) => {
  const [selectedSequence, setSelectedSequence] = useState("");

  // Mock sequence data
  const sequences = [
    { id: "seq-1", name: "Welcome Series", description: "Introduction sequence for new prospects", prospectsCount: 45 },
    { id: "seq-2", name: "Product Demo Follow-up", description: "Follow-up after product demo", prospectsCount: 23 },
    { id: "seq-3", name: "Sales Nurture", description: "Long-term nurture sequence", prospectsCount: 67 },
    { id: "seq-4", name: "Re-engagement Campaign", description: "Re-engage dormant prospects", prospectsCount: 12 },
    { id: "seq-5", name: "Event Follow-up", description: "Post-event outreach sequence", prospectsCount: 8 },
  ];

  const handleAddToSequence = () => {
    if (selectedSequence) {
      onAddToSequence(selectedSequence);
    }
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 overflow-y-auto">
      <div className="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div className="fixed inset-0 transition-opacity" aria-hidden="true">
          <div className="absolute inset-0 bg-gray-500 opacity-75"></div>

        <span className="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div className="inline-block align-bottom bg-white rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
          <div className="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <div className="sm:flex sm:items-start">
              <div className="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 sm:mx-0 sm:h-10 sm:w-10">
                <i className="fas fa-random text-blue-600"></i>
              <div className="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left flex-1">
                <h3 className="text-lg leading-6 font-medium text-gray-900">
                  Add to Sequence
                </h3>
                <div className="mt-2">
                  <p className="text-sm text-gray-500">
                    Select a sequence to add the selected prospect(s) to:
                  </p>

          <div className="px-4 sm:px-6 pb-4">
            <div className="space-y-3 max-h-64 overflow-y-auto">
              {sequences.map((sequence) => (
                <label
                  key={sequence.id}
                  className="flex items-start p-3 border border-gray-200 rounded-xl cursor-pointer hover:bg-gray-50 hover:border-blue-300 transition-all duration-200 shadow-sm hover:shadow-md"
                >
                  <input
                    type="radio"
                    name="sequence"
                    value={sequence.id}
                    checked={selectedSequence === sequence.id}
                    onChange={(e) => setSelectedSequence(e.target.value)}
                    className="mt-1 mr-3 text-blue-600 focus:ring-blue-500 border-gray-300"
                  />
                  <div className="flex-1">
                    <div className="font-medium text-gray-900">{sequence.name}</div>
                    <div className="text-sm text-gray-500 mt-1">{sequence.description}</div>
                    <div className="text-sm text-gray-500 font-medium mt-1">
                      {sequence.prospectsCount} {sequence.prospectsCount === 1 ? "prospect" : "prospects"} in sequence
                </label>
              ))}

          <div className="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
            <button
              type="button"
              onClick={handleAddToSequence}
              disabled={!selectedSequence || loading}
              className="w-full inline-flex justify-center rounded-xl border border-transparent shadow-sm px-4 py-2.5 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:border-gray-200 disabled:hover:bg-white"
            >
              {loading ? "Adding..." : "Add to Sequence"}
            </button>
            <button
              type="button"
              onClick={onClose}
              className="mt-3 w-full inline-flex justify-center rounded-xl border border-gray-200 shadow-sm px-4 py-2.5 bg-white text-base font-medium text-gray-700 hover:bg-gradient-to-r hover:from-blue-50 hover:to-indigo-50 transition-all duration-300 group focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm"
            >
              Cancel
            </button>
  );
};

const ProspectsPage: React.FC = () => {
  const navigate = useNavigate();
  const [prospects, setProspects] = useState<Prospect[]>(mockProspects);
  const [selectedProspects, setSelectedProspects] = useState<string[]>([]);
  const [searchQuery, setSearchQuery] = useState('');
  const [showResearchModal, setShowResearchModal] = useState(false);
  const [selectedProspectForResearch, setSelectedProspectForResearch] = useState<Prospect | null>(null);
  const [showDeleteModal, setShowDeleteModal] = useState(false);
  const [prospectToDelete, setProspectToDelete] = useState<Prospect | null>(null);
  const [isDeleting, setIsDeleting] = useState(false);
  const [showStatusModal, setShowStatusModal] = useState(false);
  const [prospectToUpdateStatus, setProspectToUpdateStatus] = useState<Prospect | null>(null);
  const [isUpdatingStatus, setIsUpdatingStatus] = useState(false);
  const [showImportModal, setShowImportModal] = useState(false);
  const [showAddToSequenceModal, setShowAddToSequenceModal] = useState(false);
  const [isImporting, setIsImporting] = useState(false);

  // Mock sequences data
  const sequences = [
    { id: "seq-1", name: "Welcome Series", description: "Introduction sequence for new prospects", prospectsCount: 45 },
    { id: "seq-2", name: "Product Demo Follow-up", description: "Follow-up after product demo", prospectsCount: 23 },
    { id: "seq-3", name: "Sales Nurture", description: "Long-term nurture sequence", prospectsCount: 67 },
    { id: "seq-4", name: "Re-engagement Campaign", description: "Re-engage dormant prospects", prospectsCount: 12 },
    { id: "seq-5", name: "Event Follow-up", description: "Post-event outreach sequence", prospectsCount: 8 },
  ];

  // Filter prospects based on search
  const filteredProspects = prospects.filter(prospect =>
    prospect.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
    prospect.email.toLowerCase().includes(searchQuery.toLowerCase()) ||
    prospect.company.toLowerCase().includes(searchQuery.toLowerCase())
  );

  // Handle select all
  const handleSelectAll = (checked: boolean) => {
    if (checked) {
      setSelectedProspects(filteredProspects.map(p => p.id));
    } else {
      setSelectedProspects([]);
    }
  };

  // Handle individual selection
  const handleSelectProspect = (prospectId: string, checked: boolean) => {
    if (checked) {
      setSelectedProspects(prev => [...prev, prospectId]);
    } else {
      setSelectedProspects(prev => prev.filter(id => id !== prospectId));
    }
  };

  // Handle search
  const handleSearch = (e: React.ChangeEvent<HTMLInputElement>) => {
    setSearchQuery(e.target.value);
  };

  // Handle research modal
  const handleResearchClick = (prospect: Prospect) => {
    if (prospect.researchData) {
      setSelectedProspectForResearch(prospect);
      setShowResearchModal(true);
    }
  };

  // Handle delete
  const handleDeleteClick = (prospect: Prospect) => {
    setProspectToDelete(prospect);
    setShowDeleteModal(true);
  };

  const handleDeleteConfirm = async () => {
    if (prospectToDelete) {
      setIsDeleting(true);
      // Simulate API call
      setTimeout(() => {
        setProspects(prev => prev.filter(p => p.id !== prospectToDelete.id));
        setShowDeleteModal(false);
        setProspectToDelete(null);
        setIsDeleting(false);
      }, 1000);
    }
  };

  const handleDeleteCancel = () => {
    setShowDeleteModal(false);
    setProspectToDelete(null);
  };

  // Handle status update
  const handleUpdateStatusClick = (prospect: Prospect) => {
    setProspectToUpdateStatus(prospect);
    setShowStatusModal(true);
  };

  const handleUpdateStatus = async (newStatus: ProspectStatus) => {
    if (prospectToUpdateStatus) {
      setIsUpdatingStatus(true);
      // Simulate API call
      setTimeout(() => {
        setProspects(prev => prev.map(p =>
          p.id === prospectToUpdateStatus.id
            ? { ...p, status: newStatus, updatedAt: new Date().toISOString() }
            : p
        ));
        setShowStatusModal(false);
        setProspectToUpdateStatus(null);
        setIsUpdatingStatus(false);
      }, 500);
    }
  };

  const handleStatusModalCancel = () => {
    setShowStatusModal(false);
    setProspectToUpdateStatus(null);
  };

  // Handle import
  const handleImport = (data: any[]) => {
    setIsImporting(true);
    setTimeout(() => {
      const newProspects: Prospect[] = data.map((item, index) => ({
        id: `imported-${Date.now()}-${index}`,
        name: item.name || '',
        email: item.email || '',
        company: item.company || '',
        title: item.title || '',
        website: item.website || '',
        industry: item.industry || '',
        location: item.location || '',
        linkedinProfile: item.linkedinProfile || '',
        status: 'NEW' as ProspectStatus,
        score: Math.floor(Math.random() * 40) + 60,
        tags: item.tags || [],
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        isOptedOut: false
      }));
      setProspects(prev => [...prev, ...newProspects]);
      setIsImporting(false);
      setShowImportModal(false);
      console.log(`Successfully imported ${newProspects.length} prospects`);
    }, 1500);
  };

  // Handle export
  const handleExport = () => {
    const csvContent = [
      ['Name', 'Email', 'Company', 'Title', 'Status', 'Score', 'Industry', 'Location'].join(','),
      ...filteredProspects.map(p => 
        [p.name, p.email, p.company, p.title, p.status, p.score, p.industry, p.location]
          .map(field => `"${field}"`)
          .join(',')
      )
    ].join('\n');

    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `prospects-${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    window.URL.revokeObjectURL(url);
  };

  // Handle bulk delete
  const handleBulkDelete = () => {
    if (selectedProspects.length === 0) return;
    
    if (window.confirm(`Are you sure you want to delete ${selectedProspects.length} prospect(s)?`)) {
      setProspects(prev => prev.filter(p => !selectedProspects.includes(p.id)));
      setSelectedProspects([]);
      console.log(`Successfully deleted ${selectedProspects.length} prospect(s)`);
    }
  };

  // Add to sequence
  const handleAddToSequence = () => {
    if (selectedProspects.length === 0) return;
    setShowAddToSequenceModal(true);
  };

  // Confirm add to sequence
  const handleConfirmAddToSequence = (sequenceId: string) => {
    console.log(`Adding ${selectedProspects.length} prospects to sequence: ${sequenceId}`);
    
    // Update prospects with sequence
    setProspects(prev => prev.map(prospect => 
      selectedProspects.includes(prospect.id)
        ? { ...prospect, sequenceId, sequenceName: sequences.find(s => s.id === sequenceId)?.name || 'Unknown Sequence' }
        : prospect
    ));

    setShowAddToSequenceModal(false);
    setSelectedProspects([]);

    // Show success message
    console.log(`Successfully added ${selectedProspects.length} prospect(s) to sequence`);
  };

  // Status configuration
  const statusConfig: Record<ProspectStatus, { label: string; color: string; bgColor: string }> = {
    NEW: { label: 'New', color: 'text-gray-800', bgColor: 'bg-gray-100' },
    CONTACTED: { label: 'Contacted', color: 'text-blue-800', bgColor: 'bg-blue-100' },
    ENGAGED: { label: 'Engaged', color: 'text-purple-800', bgColor: 'bg-purple-100' },
    REPLIED: { label: 'Replied', color: 'text-green-800', bgColor: 'bg-green-100' },
    INTERESTED: { label: 'Interested', color: 'text-yellow-800', bgColor: 'bg-yellow-100' },
    NOT_INTERESTED: { label: 'Not Interested', color: 'text-red-800', bgColor: 'bg-red-100' },
    OPTED_OUT: { label: 'Opted Out', color: 'text-gray-600', bgColor: 'bg-gray-50' },
    CONVERTED: { label: 'Converted', color: 'text-emerald-800', bgColor: 'bg-emerald-100' },
    BOUNCED: { label: 'Bounced', color: 'text-orange-800', bgColor: 'bg-orange-100' }
  };

  // Bulk actions component
  const BulkActionsBar: React.FC<{ selectedCount: number; onAddToSequence: () => void; onExport: () => void; onDelete: () => void }> = ({ 
    selectedCount, onAddToSequence, onExport, onDelete 
  }) => (
    <div className="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 px-6 py-4 rounded-xl flex flex-wrap items-center justify-between gap-3 shadow-sm">
      <span className="text-base font-semibold text-blue-900">
        {selectedCount} {selectedCount === 1 ? 'prospect' : 'prospects'} selected
      </span>
      <div className="flex items-center gap-2">
        <button
          onClick={onAddToSequence}
          className="inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gradient-to-r hover:from-blue-50 hover:to-indigo-50 transition-all duration-300 group focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
        >
          <i className="fas fa-plus-circle mr-2 text-sm"></i>
          Add to Sequence
        </button>
        <button
          onClick={onExport}
          className="inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gradient-to-r hover:from-blue-50 hover:to-indigo-50 transition-all duration-300 group focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
        >
          <i className="fas fa-download mr-2 text-sm"></i>
          Export
        </button>
        <button
          onClick={onDelete}
          className="inline-flex items-center px-4 py-2 border border-red-200 shadow-sm text-sm font-medium rounded-lg text-red-700 bg-white hover:bg-red-50 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
        >
          <i className="fas fa-trash mr-2 text-sm"></i>
          Delete
        </button>
<div className="flex flex-col sm:flex-row gap-3 justify-end">
          <div className="flex gap-2">
            <button
              onClick={() => setShowImportModal(true)}
              className="inline-flex items-center justify-center rounded-xl border border-gray-200 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-all duration-200 shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              <i className="fas fa-file-import mr-2"></i>
              Import
            </button>
            <button
              onClick={handleExport}
              className="inline-flex items-center justify-center rounded-lg border border-transparent bg-blue-600 text-base font-semibold text-white hover:bg-blue-700 transition-colors shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              <i className="fas fa-plus mr-2"></i>
              Add Prospect
            </button>

      {/* Table */}
      <div className="bg-white shadow overflow-hidden sm:rounded-lg">
{selectedProspects.length > 0         {selectedProspects.length > 0 && (        {selectedProspects.length > 0 && ( (
        <div className="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl shadow-sm border border-blue-100 p-4 mb-6">
          <BulkActionsBar
            selectedCount={selectedProspects.length}
            onAddToSequence={handleAddToSequence}
            onExport={handleExport}
            onDelete={handleBulkDelete}
          />
        )}

        <div className="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden"><div className="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-gray-50 to-gray-100"><div className="flex items-center justify-between"><h2 className="text-lg font-semibold text-gray-900">Prospect List</h2><div className="flex items-center space-x-1 text-sm text-gray-500"><i className="fas fa-users"></i><span>{filteredProspects.length} total</span></div></div></div><ul className="divide-y divide-gray-100">
          {filteredProspects.map((prospect) => (
            <li key={prospect.id} className="hover:bg-gradient-to-r hover:from-blue-50 hover:to-indigo-50 transition-all duration-300 group">
              <div className="px-6 py-5 flex items-center justify-between">
                <div className="flex items-center space-x-3 flex-1 min-w-0">
                  <input
                    type="checkbox"
                    checked={selectedProspects.includes(prospect.id)}
                    onChange={(e) => handleSelectProspect(prospect.id, e.target.checked)}
                    className="h-5 w-5 text-blue-600 focus:ring-blue-500 focus:ring-2 border-gray-300 rounded-lg transition-colors group-hover:border-blue-400"
                  />
                  <div className="flex-shrink-0">
                    <div className="h-14 w-14 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg group-hover:shadow-xl transition-all duration-300 group-hover:scale-105 flex items-center justify-center">
                      <span className="text-base font-semibold text-white">
                        {prospect.name.split(' ').map(n => n[0]).join('')}
                      </span>
                  <div className="flex-1 min-w-0">
                    <p className="text-base font-semibold text-gray-900 truncate group-hover:text-blue-600 transition-colors">
                      {prospect.name}
                    </p>
                    <p className="text-sm text-gray-600 truncate group-hover:text-gray-700 transition-colors">
                      {prospect.email}
                    </p>
                    <div className="flex items-center space-x-3 mt-2">
                      <span className="text-sm text-gray-500 font-medium">{prospect.company}</span>
                      <span className="text-sm text-gray-500 font-medium">•</span>
                      <span className={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold shadow-sm ${statusConfig[prospect.status].bgColor} ${statusConfig[prospect.status].color}`}>
                        {statusConfig[prospect.status].label}
                      </span>
                <div className="flex items-center space-x-1">
                  {prospect.researchData ? (
                    <button
                      onClick={() => handleResearchClick(prospect)}
                      className="inline-flex items-center px-3 py-1.5 bg-blue-100 text-blue-700 text-sm font-medium rounded-lg hover:bg-blue-200 transition-colors"
                    >
                      <i className="fas fa-search mr-1 text-xs"></i>
                      Researched
                    </button>
                  ) : (
                    <span className="inline-flex items-center px-3 py-1.5 bg-gray-100 text-gray-600 text-sm font-medium rounded-lg">
                      <i className="fas fa-search mr-1 text-xs"></i>
                      Not Researched
                    </span>
                  )}
                  <div className="flex items-center space-x-1">
                    <button
                      onClick={() => navigate(`/dashboard/prospects/${prospect.id}/edit`)}
                      className="w-8 h-8 rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 hover:text-gray-800 flex items-center justify-center transition-all duration-200"
                    >
                      <i className="fas fa-edit"></i>
                    </button>
                    <button
                      onClick={() => handleUpdateStatusClick(prospect)}
                      className="w-8 h-8 rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 hover:text-gray-800 flex items-center justify-center transition-all duration-200"
                    >
                      <i className="fas fa-sync-alt"></i>
                    </button>
                    <button
                      onClick={() => handleDeleteClick(prospect)}
                      className="w-8 h-8 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-700 flex items-center justify-center transition-all duration-200"
                    >
                      <i className="fas fa-trash"></i>
                    </button>
            </li>
          ))}
        </ul>
  );
};

export default ProspectsPage;
