generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  neonUserId     String           @unique
  email          String           @unique
  name           String
  company        String?
  title          String?
  isActive       Boolean          @default(true)
  lastLoginAt    DateTime?
  emailConfirmed Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  campaigns      Sequence[]
  emailTemplates EmailTemplate[]
  prospects      Prospect[]
  sessions       Session[]
  tasks          TaskAssignment[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model EmailTemplate {
  id               String            @id @default(cuid())
  name             String
  subject          String
  body             String
  variables        String[]
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  stepEmailActions StepEmailAction[]

  @@map("email_templates")
}

model Prospect {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  company           String?
  title             String?
  website           String?
  industry          String?
  linkedinProfile   String?
  phoneNumber       String?
  location          String?
  notes             String?
  researchData      Json?
  source            String?
  isOptedOut        Boolean            @default(false)
  tags              String[]
  status            ProspectStatus     @default(NEW)
  createdBy         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  campaignProspects CampaignProspect[]
  creator           User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("prospects")
}

model Sequence {
  id                String             @id @default(cuid())
  name              String
  description       String?
  status            SequenceStatus     @default(DRAFT)
  createdBy         String
  startedAt         DateTime?
  pausedAt          DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  campaignProspects CampaignProspect[]
  steps             SequenceStep[]
  creator           User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("campaigns")
}

model SequenceStep {
  id          String           @id @default(cuid())
  sequenceId  String
  day         Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sequence    Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  emailAction StepEmailAction?
  taskAction  StepTaskAction?

  @@unique([sequenceId, day])
  @@map("campaign_steps")
}

model StepEmailAction {
  id                    String              @id @default(cuid())
  stepId                String              @unique
  templateId            String?
  customSubject         String?
  customBody            String?
  enablePersonalization Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  personalizedEmails    PersonalizedEmail[]
  step                  SequenceStep        @relation(fields: [stepId], references: [id], onDelete: Cascade)
  template              EmailTemplate?      @relation(fields: [templateId], references: [id])

  @@map("step_email_actions")
}

model StepTaskAction {
  id                      String       @id @default(cuid())
  stepId                  String       @unique
  taskTitle               String
  taskDescription         String?
  enableEmailNotification Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  step                    SequenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  tasks                   Task[]

  @@map("step_task_actions")
}

model CampaignProspect {
  id                 String              @id @default(cuid())
  campaignId         String
  prospectId         String
  addedAt            DateTime            @default(now())
  pausedAt           DateTime?
  status             ProspectStatus      @default(NEW)
  sequence           Sequence            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospect           Prospect            @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  personalizedEmails PersonalizedEmail[]

  @@unique([campaignId, prospectId])
  @@map("campaign_prospects")
}

model PersonalizedEmail {
  id                 String           @id @default(cuid())
  campaignProspectId String
  stepEmailActionId  String
  subject            String
  body               String
  status             EmailStatus      @default(PENDING)
  scheduledFor       DateTime?
  sentAt             DateTime?
  openedAt           DateTime?
  repliedAt          DateTime?
  errorMessage       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  campaignProspect   CampaignProspect @relation(fields: [campaignProspectId], references: [id], onDelete: Cascade)
  stepEmailAction    StepEmailAction  @relation(fields: [stepEmailActionId], references: [id], onDelete: Cascade)

  @@unique([campaignProspectId, stepEmailActionId])
  @@map("personalized_emails")
}

model Task {
  id               String           @id @default(cuid())
  stepTaskActionId String
  campaignId       String
  dueDate          DateTime?
  status           TaskStatus       @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignments      TaskAssignment[]
  stepTaskAction   StepTaskAction   @relation(fields: [stepTaskActionId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model EmailLog {
  id                  String      @id @default(cuid())
  personalizedEmailId String?
  to                  String
  from                String
  subject             String
  status              EmailStatus @default(PENDING)
  providerId          String?
  openedAt            DateTime?
  repliedAt           DateTime?
  bouncedAt           DateTime?
  bouncedReason       String?
  errorMessage        String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("email_logs")
}

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProspectStatus {
  NEW
  RUNNING
  PAUSED
  CONTACTED
  ENGAGED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  OPTED_OUT
  CONVERTED
  BOUNCED
  ENDED
}

enum EmailStatus {
  PENDING
  SCHEDULED
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}
